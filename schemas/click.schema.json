{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "clickID": {
        "type": "string",
        "description": "A unique identifier for the click, includes the link ID"
      },
      "ip": {
        "type": "string",
        "description": "the IP address of the user that accessed the link"
      },
      "linkID": {
        "type": "string",
        "description": "the display ID of the link that was clicked"
      },
      "timestamp": {
        "type": "integer",
        "description": "the date and time when the link was accessed"
      },
      "userAgent": {
        "type": "string",
        "description": "the user agent of the client that accessed the link"
      },
      "os": {
        "type": "string",
        "description": "the operating system derived from the user agent"
      },
      "client": {
        "type": "string",
        "description": "the client info (browser, etc) derived from the user agent"
      },
      "device": {
        "type": "string",
        "description": "the device type derived from the user agent"
      },
      "location": {
        "type": "string",
        "description": "https://ip-api.com/docs/api:json"
      },
      "isp": {
        "type": "string",
        "description": "https://ip-api.com/docs/api:json"
      },
      "mobile": {
        "type": "boolean",
        "description": "https://ip-api.com/docs/api:json"
      },
      "proxy": {
        "type": "boolean",
        "description": "https://ip-api.com/docs/api:json"
      },
      "hosting": {
        "type": "boolean",
        "description": "https://ip-api.com/docs/api:json"
      },
      "asn": {
        "type": "string",
        "description": "https://ip-api.com/docs/api:json"
      }
    },
    "required": [
      "clickID",
      "linkID",
      "ip",
      "timestamp",
      "userAgent"
    ],
    "$example": {
      "clickID": "ABC123_1696166400",
      "linkID": "ABC123",
      "ip": "102.89.27.56",
      "timestamp": 1696166400,
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/92.0.4515.131 Safari/537.36",
      "os": "Windows 10",
      "client": "Chrome 92.0.4515.131",
      "device": "Desktop",
      "location": "Lagos, Nigeria",
      "isp": "MTN NIGERIA Communication limited",
      "asn": "VCG-AS",
      "mobile": true,
      "proxy": false,
      "hosting": true
    }
  }
