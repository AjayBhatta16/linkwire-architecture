{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "logID": {
        "type": "string",
        "description": "unique identifier for the login attempt, includes the link ID"
      },
      "ipAddress": {
        "type": "string",
        "description": "the IP address that the login attempt originated from"
      },
      "timestamp": {
        "type": "integer",
        "description": "the date and time when the login attempt was entered"
      },
      "username": {
        "type": "string",
        "description": "the username entered"
      },
      "password": {
        "type": "string",
        "description": "the plain-text password entered"
      }
    },
    "required": [
      "logID",
      "ipAddress",
      "timestamp",
      "username",
      "password"
    ],
    "$example": {
      "logID": "ABC123_1696166400",
      "ipAddress": "102.89.17.38",
      "timestamp": 1696166400,
      "username": "john_doe",
      "password": "plain_text_password"
    }
  }